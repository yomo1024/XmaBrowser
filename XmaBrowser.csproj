<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.5.1</Version>
    <Author>yomo1024</Author>
    <Name>XMA Browser</Name>
    <Punchline>在游戏里逛 XIV Mod Archive，点一下就装进 Penumbra。</Punchline>
    <Description>把 XIV Mod Archive（XIVModArchive.com）搬进游戏：搜索、浏览、看详情，一键把 Mod 装进 Penumbra 并即时生效。
公开内容直连站点；需要登录的内容（NSFW）走本机浏览器的登录态通道，用户无需在插件里做任何登录操作。
只读站点公开数据，不修改任何本地管理器的数据。</Description>
    <RepoUrl>https://github.com/yomo1024/XmaBrowser</RepoUrl>
    <Tags>mods;penumbra;xivmodarchive;browser;xma;mod-manager</Tags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/ 是独立的控制台测试项目，不属于插件本体 -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Penumbra 类型化 IPC：直接 new Xxx(pi).Invoke(...)，不手写 IPC 字符串 -->
    <PackageReference Include="Penumbra.Api" Version="5.19.2" />
    <!-- HTML 解析（纯托管） -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.65" />
    <!-- 读 7z/rar/tar 等容器（zip 走 .NET 内置 System.IO.Compression）。
         版本必须 >= 0.48.0：更低版本有 zip slip 变体告警 GHSA-6c8g-7p36-r338（会破坏 0 警告口径）。
         本机实测 1.0.0 构建无告警；可读 Zip/Rar/7Zip/GZip/Tar/Arc/Arj/Ace，但**不支持写 7z**。 -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

</Project>
