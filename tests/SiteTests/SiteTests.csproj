<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SiteTests</AssemblyName>
    <RootNamespace>SiteTests</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.65" />
    <!-- 与插件同版本：测试要真的去读 .7z 夹具 -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接编译插件的源码：测的就是真东西，且不需要 Dalamud / 不需要游戏。
         同一份代码既跑离线断言（不用网），也能加 live 参数跑联网实测。 -->
    <Compile Include="..\..\Site\IXmaLog.cs" />
    <Compile Include="..\..\Site\IXmaSettings.cs" />
    <Compile Include="..\..\Site\FetchLimits.cs" />
    <Compile Include="..\..\Site\XmaModels.cs" />
    <Compile Include="..\..\Site\XmaBlock.cs" />
    <Compile Include="..\..\Site\SearchRouting.cs" />
    <Compile Include="..\..\Site\SearchCache.cs" />
    <Compile Include="..\..\Site\DetailCache.cs" />
    <Compile Include="..\..\Site\NeedsLoginMemory.cs" />
    <Compile Include="..\..\Site\DirectBlockMemory.cs" />
    <Compile Include="..\..\Site\LoginStateDetector.cs" />
    <Compile Include="..\..\Site\XmaParser.cs" />
    <Compile Include="..\..\Site\XmaClient.cs" />
    <Compile Include="..\..\Install\PackageResolver.cs" />
    <Compile Include="..\..\Install\GroupPath.cs" />
    <Compile Include="..\..\Install\Archives\IArchiveReader.cs" />
    <Compile Include="..\..\Cover\CoverContext.cs" />
    <Compile Include="..\..\Cover\CoverLocator.cs" />
    <Compile Include="..\..\Cover\CoverInjector.cs" />
    <Compile Include="..\..\Browser\IBrowserSettings.cs" />
    <Compile Include="..\..\Browser\CdpClient.cs" />
    <Compile Include="..\..\Browser\BrowserChannel.cs" />
    <!-- 翻译器：纯 HTTP + JSON，不含 Dalamud 依赖，所以能在这里真连接口测 -->
    <Compile Include="..\..\Translate\Translator.cs" />
    <Compile Include="..\..\Translate\ProxyInfo.cs" />
    <Compile Include="..\..\Diagnostics\NsfwDiagnostics.cs" />
    <Compile Include="..\..\Favorites\FavoriteStore.cs" />
    <Compile Include="..\..\Ui\UiScale.cs" />
    <Compile Include="..\..\Ui\LoadProgress.cs" />
    <Compile Include="..\..\Ui\ImageJobState.cs" />
    <Compile Include="..\..\Ui\CacheMaintenance.cs" />
    <Compile Include="..\..\Ui\StreamState.cs" />
    <Compile Include="..\..\Ui\GridLayout.cs" />
    <Compile Include="..\..\Ui\SearchForm.cs" />
    <Compile Include="..\..\Site\PackageIndex.cs" />
    <Compile Include="..\..\Site\TextSearch.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
